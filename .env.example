# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (e.g. qwen-2.5-32b, qwen/qwen3.8-27b, gpt-oss-20b)
GROQ_MODEL=qwen/qwen3.8-27b

# Timeout in seconds before falling back to raw Whisper output (2 to 3 seconds)
GROQ_TIMEOUT=2.5

# Temperature (0.0 for deterministic cleanup)
GROQ_TEMPERATURE=0.0

# Enable/Disable Groq post-processing
GROQ_ENABLED=true
